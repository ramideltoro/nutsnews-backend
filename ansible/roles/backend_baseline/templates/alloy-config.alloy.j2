logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    name = "grafana-cloud-prometheus"
    url  = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_PROMETHEUS_PASSWORD")
    }

    queue_config {
      capacity             = {{ backend_metrics_remote_write_capacity }}
      max_samples_per_send = {{ backend_metrics_remote_write_max_samples_per_send }}
      min_shards           = 1
      max_shards           = {{ backend_metrics_remote_write_max_shards }}
    }
  }
}

prometheus.exporter.unix "host" {
  set_collectors = [
    "cpu",
    "diskstats",
    "filesystem",
    "loadavg",
    "meminfo",
    "netdev",
    "pressure",
    "stat",
    "systemd",
    "textfile",
    "time",
    "uname",
    "vmstat",
  ]

  filesystem {
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
  }

  systemd {
    enable_restarts = true
    unit_include    = "^(ssh|ufw|fail2ban|caddy|docker|postgresql|alloy|sysstat|nutsnews-.+)\\.(service|timer)$"
  }

  textfile {
    directory = "{{ backend_metrics_textfile_dir }}"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "{{ backend_metrics_scrape_interval }}"
  forward_to      = [prometheus.relabel.backend.receiver]
}

prometheus.relabel "backend" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    target_label = "job"
    replacement  = "nutsnews-backend-host"
  }

  rule {
    target_label = "instance"
    replacement  = "{{ backend_metrics_instance_label }}"
  }

  rule {
    target_label = "environment"
    replacement  = "{{ backend_metrics_environment_label }}"
  }
}

{% if backend_logs_enabled | bool %}
loki.write "grafana_cloud_loki" {
  max_streams = {{ backend_logs_loki_max_streams }}

  endpoint {
    url        = sys.env("GRAFANA_CLOUD_LOKI_URL")
    batch_size = "{{ backend_logs_loki_batch_size }}"
    batch_wait = "{{ backend_logs_loki_batch_wait }}"

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_LOKI_PASSWORD")
    }
  }
}

loki.relabel "journal_context" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
  }
}

local.file_match "backend_logs" {
  path_targets = [
{% for target in backend_logs_file_targets %}
    {
      "__path__" = "{{ target.path }}",
      environment = "{{ backend_metrics_environment_label }}",
      host = "{{ backend_metrics_instance_label }}",
      source = "file",
      service = "{{ target.service }}",
      unit = "{{ target.unit }}",
    },
{% endfor %}
  ]
  ignore_older_than = "{{ backend_logs_file_ignore_older_than }}"
}

loki.source.file "backend_logs" {
  targets    = local.file_match.backend_logs.targets
  forward_to = [loki.process.backend_logs.receiver]
}

{% for source in backend_logs_journal_units %}
loki.source.journal "{{ source.unit | regex_replace('[^A-Za-z0-9_]', '_') }}" {
  max_age       = "{{ backend_logs_journal_max_age }}"
  matches       = "_SYSTEMD_UNIT={{ source.unit }}"
  relabel_rules = loki.relabel.journal_context.rules
  labels        = {
    environment = "{{ backend_metrics_environment_label }}",
    host        = "{{ backend_metrics_instance_label }}",
    source      = "journal",
    service     = "{{ source.service }}",
    unit        = "{{ source.unit }}",
  }
  forward_to = [loki.process.backend_logs.receiver]
}

{% endfor %}
loki.process "backend_logs" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  stage.drop {
    expression          = "(?i)(BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) KEY|PRIVATE KEY-----)"
    drop_counter_reason = "private_key_marker"
  }

  stage.drop {
    longer_than         = "{{ backend_logs_line_drop_max_size }}"
    drop_counter_reason = "oversized_log_line"
  }

  stage.replace {
    expression = "(?i)authorization[:=][[:space:]]*(?:bearer|basic)[[:space:]]+([^[:space:]\\\"']+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)(?:cookie|set-cookie)[:=][[:space:]]*([^\\n\\r]+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)(?:api[_-]?key|access[_-]?token|refresh[_-]?token|oauth[_-]?(?:code|token)|password|passwd|pwd|secret|session|token)[[:space:]]*[:=][[:space:]]*([^[:space:],&\\\"']+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "([?][^[:space:]\\\"']+)"
    replace    = "?[REDACTED_QUERY]"
  }

  stage.replace {
    expression = "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})"
    replace    = "[REDACTED_EMAIL]"
  }

  stage.truncate {
    rule {
      limit  = "{{ backend_logs_line_truncate_limit }}"
      suffix = "...[TRUNCATED]"
    }
  }

  stage.label_keep {
    values = ["environment", "host", "source", "service", "unit", "severity", "filename", "job"]
  }
}
{% endif %}
