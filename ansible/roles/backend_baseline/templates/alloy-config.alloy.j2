{% if backend_metrics_caddy_tls_probe_enabled | bool %}
prometheus.exporter.blackbox "caddy_tls" {
  config = "{ modules: { http_tls: { prober: http, timeout: 8s, http: { method: GET, valid_status_codes: [200], preferred_ip_protocol: ip4 } } } }"

  target {
    name    = "backend-caddy-tls"
    address = "https://{{ backend_domain }}{{ backend_metrics_caddy_tls_probe_path }}"
    module  = "http_tls"
    labels = {
      service = "caddy",
      probe   = "tls",
      check   = "certificate",
    }
  }
}

prometheus.scrape "caddy_tls" {
  targets         = prometheus.exporter.blackbox.caddy_tls.targets
  scrape_interval = "{{ backend_metrics_caddy_tls_scrape_interval }}"
  scrape_timeout  = "{{ backend_metrics_caddy_tls_scrape_timeout }}"
