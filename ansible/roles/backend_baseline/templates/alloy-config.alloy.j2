{% if backend_logs_enabled | bool %}
loki.write "grafana_cloud_loki" {
  max_streams = {{ backend_logs_loki_max_streams }}

  endpoint {
    url        = sys.env("GRAFANA_CLOUD_LOKI_URL")
    batch_size = "{{ backend_logs_loki_batch_size }}"
    batch_wait = "{{ backend_logs_loki_batch_wait }}"

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_LOKI_PASSWORD")
    }
  }
}

loki.relabel "journal_context" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(trace|debug)$"
    replacement   = "debug"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(info|notice)$"
    replacement   = "info"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(warn|warning)$"
    replacement   = "warning"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(err|error)$"
    replacement   = "error"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(fatal|panic|critical|crit|alert|emerg|emergency)$"
    replacement   = "critical"
  }

}

local.file_match "backend_logs" {
  path_targets = [
{% for target in backend_logs_file_targets %}
    {
      "__path__"             = "{{ target.path }}",
      deployment_environment = "{{ backend_metrics_environment_label }}",
      host                   = "{{ backend_metrics_instance_label }}",
      source                 = "{{ target.source | default('file') }}",
      service                = "{{ target.service }}",
      service_version        = "{{ target.service_version | default('unknown') }}",
      severity               = "info",
    },
{% endfor %}
  ]
  ignore_older_than = "{{ backend_logs_file_ignore_older_than }}"
}

loki.source.file "backend_logs" {
  targets    = local.file_match.backend_logs.targets
  forward_to = [loki.process.backend_logs.receiver]
}

{% for source in backend_logs_journal_units %}
loki.source.journal "{{ source.unit | regex_replace('[^A-Za-z0-9_]', '_') }}" {
  max_age       = "{{ backend_logs_journal_max_age }}"
  matches       = "_SYSTEMD_UNIT={{ source.unit }}"
  relabel_rules = loki.relabel.journal_context.rules
  labels        = {
    deployment_environment = "{{ backend_metrics_environment_label }}",
    host                   = "{{ backend_metrics_instance_label }}",
    source                 = "journal",
    service                = "{{ source.service }}",
    service_version        = "{{ source.service_version | default('unknown') }}",
    severity               = "info",
  }
  forward_to = [loki.process.backend_logs.receiver]
}

{% endfor %}
loki.relabel "worker_uplift_container_context" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(trace|debug)$"
    replacement   = "debug"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(info|notice)$"
    replacement   = "info"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(warn|warning)$"
    replacement   = "warning"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(err|error)$"
    replacement   = "error"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(fatal|panic|critical|crit|alert|emerg|emergency)$"
    replacement   = "critical"
  }

  // Docker's journald driver sanitizes immutable container labels into
  // upper-case fields; Alloy exposes them as lower-case __journal_ labels.
  rule {
    source_labels = ["__journal_com_nutsnews_service_version"]
    target_label  = "service_version"
    regex         = "^([0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?)$"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal_com_nutsnews_revision"]
    target_label  = "deployed_revision"
    regex         = "^([0-9a-f]{40})$"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal_com_nutsnews_image_digest"]
    target_label  = "deployed_image_digest"
    regex         = "^(sha256:[0-9a-f]{64})$"
    replacement   = "$1"
  }
}

{% for source in backend_logs_worker_uplift_container_sources %}
loki.source.journal "container_{{ source.tag | regex_replace('[^A-Za-z0-9_]', '_') }}" {
  max_age       = "{{ backend_logs_journal_max_age }}"
  matches       = "CONTAINER_TAG={{ source.tag }}"
  relabel_rules = loki.relabel.worker_uplift_container_context.rules
  labels        = {
    deployment_environment = "{{ backend_metrics_environment_label }}",
    host                   = "{{ backend_metrics_instance_label }}",
    source                 = "container",
    service                = "{{ source.service }}",
    service_version        = "{{ source.service_version | default('unknown') }}",
    severity               = "info",
  }
  forward_to = [loki.process.backend_logs.receiver]
}

{% endfor %}
loki.process "backend_logs" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  stage.json {
    expressions = {
      raw_severity    = "level || severity",
      request_id      = "requestId || request_id",
      correlation_id  = "correlationId || correlation_id",
      causation_id    = "causationId || causation_id",
      message_id      = "messageId || message_id",
      idempotency_key = "idempotencyKey || idempotency_key",
      trace_id        = "traceId || trace_id",
      article_id      = "articleId || article_id",
      feed_id         = "feedId || feed_id",
      pipeline_run_id = "pipelineRunId || pipeline_run_id",
      traceparent     = "traceparent",
      tracestate      = "tracestate",
      queue           = "queue",
      outcome         = "outcome",
    }
    drop_malformed = false
  }

  stage.labels {
    values = {
      raw_severity = "raw_severity",
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(trace|debug)$\"}"

    stage.static_labels {
      values = { severity = "debug" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(info|notice)$\"}"

    stage.static_labels {
      values = { severity = "info" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(warn|warning)$\"}"

    stage.static_labels {
      values = { severity = "warning" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(err|error)$\"}"

    stage.static_labels {
      values = { severity = "error" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(fatal|panic|critical|crit|alert|emerg|emergency)$\"}"

    stage.static_labels {
      values = { severity = "critical" }
    }
  }

  stage.match {
    selector            = "{severity=\"debug\"}"
    action              = "drop"
    drop_counter_reason = "debug_trace_log_level"
  }

  stage.drop {
    expression          = "(?i)(BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) KEY|PRIVATE KEY-----)"
    drop_counter_reason = "private_key_marker"
  }

  stage.drop {
    longer_than         = "{{ backend_logs_line_drop_max_size }}"
    drop_counter_reason = "oversized_log_line"
  }

  stage.replace {
    expression = "(?i)authorization[:=][[:space:]]*(?:bearer|basic)[[:space:]]+([^[:space:]\\\"']+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)(?:cookie|set-cookie)[:=][[:space:]]*([^\\n\\r]+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)(?:api[_-]?key|access[_-]?token|refresh[_-]?token|oauth[_-]?(?:code|token)|password|passwd|pwd|secret|session|token)[[:space:]]*[:=][[:space:]]*([^[:space:],&\\\"']+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "([?][^[:space:]\\\"']+)"
    replace    = "?[REDACTED_QUERY]"
  }

  stage.replace {
    expression = "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})"
    replace    = "[REDACTED_EMAIL]"
  }

  stage.truncate {
    rule {
      limit  = "{{ backend_logs_line_truncate_limit }}"
      suffix = "...[TRUNCATED]"
    }
  }

  stage.structured_metadata {
    values = {
      request_id      = "",
      correlation_id  = "",
      causation_id    = "",
      message_id      = "",
      idempotency_key = "",
      trace_id        = "",
      article_id      = "",
      feed_id         = "",
      pipeline_run_id = "",
      traceparent     = "",
      tracestate      = "",
      queue           = "",
      outcome         = "",
      revision        = "deployed_revision",
      image_digest    = "deployed_image_digest",
    }
  }

  stage.label_keep {
    values = ["deployment_environment", "service", "service_version", "host", "source", "severity"]
  }
}
{% endif %}
