    source_labels = ["__name__"]
    regex         = "^(up|scrape_.+|nutsnews_backend_api_.+)$"
    action        = "keep"
  }

  rule {
    target_label = "job"
    replacement  = "nutsnews-backend-api"
  }

  rule {
    target_label = "instance"
