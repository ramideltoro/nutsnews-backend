{% endif %}
{% if backend_metrics_worker_uplift_enabled | bool %}
prometheus.scrape "worker_uplift" {
  targets = [
{% for target in backend_metrics_worker_uplift_targets %}
    {
      "__address__"   = "{{ target.address }}",
      service          = "{{ target.service }}",
      stage            = "{{ target.stage }}",
      observability_contract = "{{ backend_metrics_worker_uplift_contract_status }}",
      deployment_mode  = "{{ backend_metrics_worker_uplift_deployment_mode }}",
      expected_active  = "{{ backend_metrics_worker_uplift_expected_active }}",
    },
{% endfor %}
  ]
  metrics_path    = "/metrics"
  scrape_interval = "{{ backend_metrics_worker_uplift_scrape_interval }}"
  scrape_timeout  = "{{ backend_metrics_worker_uplift_scrape_timeout }}"
  sample_limit    = {{ backend_metrics_worker_uplift_sample_limit }}
  label_limit     = {{ backend_metrics_worker_uplift_label_limit }}
  forward_to      = [prometheus.relabel.worker_uplift.receiver]
}

prometheus.relabel "worker_uplift" {
  forward_to     = [prometheus.remote_write.grafana_cloud.receiver]
  max_cache_size = {{ backend_metrics_worker_uplift_relabel_cache_size }}

  rule {
    source_labels = ["__name__"]
    regex         = "^(up|scrape_.+|nutsnews_.+)$"
    action        = "keep"
  }

  // Readiness state is retained below. Per-check duration histograms multiply
  // eight services, 44 checks, three probes, and 16 buckets without informing
  // a production SLO, so they are intentionally excluded from remote write.
  rule {
    source_labels = ["__name__"]
    regex         = "^nutsnews_worker_health_check_duration_seconds_(bucket|sum|count)$"
    action        = "drop"
  }

  rule {
    target_label = "job"
    replacement  = "nutsnews-worker-uplift"
  }

  rule {
    target_label = "instance"
    replacement  = "{{ backend_metrics_instance_label }}"
  }

  rule {
    target_label = "host"
    replacement  = "{{ backend_metrics_instance_label }}"
  }

  rule {
    target_label = "environment"
    replacement  = "{{ backend_metrics_environment_label }}"
  }

  rule {
    target_label = "deployment_environment"
    replacement  = "{{ backend_metrics_environment_label }}"
  }

  rule {
    target_label = "service_namespace"
    replacement  = "nutsnews"
  }

  rule {
    regex  = "^(article|article_id|feed|feed_id|message|message_id|idempotency|idempotency_key|trace_id|span_id|correlation_id|causation_id|payload|url|path|user|ip|token|secret|prompt|model_output)$"
    action = "labeldrop"
  }

  // result/retry/token_kind remain temporarily for metrics already emitted by
  // the shadow images; all are finite enums and are removed at image rollout.
  rule {
    regex  = "^(__name__|job|instance|environment|deployment_environment|host|service|service_namespace|version|revision|stage|queue|outcome|dependency|language|provider|probe|check|le|observability_contract|deployment_mode|expected_active|deployment|adapter|result|retry|retry_class|token_kind)$"
    action = "labelkeep"
  }
}

{% endif %}
