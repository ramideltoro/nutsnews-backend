{% if backend_logs_enabled | bool %}
loki.write "grafana_cloud_loki" {
  max_streams = {{ backend_logs_loki_max_streams }}

  endpoint {
    url        = sys.env("GRAFANA_CLOUD_LOKI_URL")
    batch_size = "{{ backend_logs_loki_batch_size }}"
    batch_wait = "{{ backend_logs_loki_batch_wait }}"

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_LOKI_PASSWORD")
    }
  }
}

loki.relabel "journal_context" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(trace|debug)$"
    replacement   = "debug"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(info|notice)$"
    replacement   = "info"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(warn|warning)$"
    replacement   = "warning"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(err|error)$"
    replacement   = "error"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(fatal|panic|critical|crit|alert|emerg|emergency)$"
    replacement   = "critical"
  }

}

local.file_match "backend_logs" {
  path_targets = [
{% for target in backend_logs_file_targets %}
    {
      "__path__"             = "{{ target.path }}",
      deployment_environment = "{{ backend_metrics_environment_label }}",
      host                   = "{{ backend_metrics_instance_label }}",
      source                 = "{{ target.source | default('file') }}",
      service                = "{{ target.service }}",
      service_version        = "{{ target.service_version | default('unknown') }}",
      severity               = "info",
    },
{% endfor %}
  ]
  ignore_older_than = "{{ backend_logs_file_ignore_older_than }}"
}

loki.source.file "backend_logs" {
  targets    = local.file_match.backend_logs.targets
  forward_to = [loki.process.backend_logs.receiver]
}

{% for source in backend_logs_journal_units %}
loki.source.journal "{{ source.unit | regex_replace('[^A-Za-z0-9_]', '_') }}" {
  max_age       = "{{ backend_logs_journal_max_age }}"
  matches       = "_SYSTEMD_UNIT={{ source.unit }}"
  relabel_rules = loki.relabel.journal_context.rules
  labels        = {
    deployment_environment = "{{ backend_metrics_environment_label }}",
    host                   = "{{ backend_metrics_instance_label }}",
    source                 = "journal",
    service                = "{{ source.service }}",
    service_version        = "{{ source.service_version | default('unknown') }}",
    severity               = "info",
  }
  forward_to = [loki.process.backend_logs.receiver]
}

{% endfor %}
loki.relabel "worker_uplift_container_context" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(trace|debug)$"
    replacement   = "debug"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(info|notice)$"
    replacement   = "info"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(warn|warning)$"
    replacement   = "warning"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(err|error)$"
    replacement   = "error"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "severity"
    regex         = "(?i)^(fatal|panic|critical|crit|alert|emerg|emergency)$"
    replacement   = "critical"
  }

  // Docker's journald driver sanitizes immutable container labels into
  // upper-case fields; Alloy exposes them as lower-case __journal_ labels.
  rule {
    source_labels = ["__journal_com_nutsnews_service_version"]
    target_label  = "service_version"
    regex         = "^([0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?)$"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal_com_nutsnews_revision"]
    target_label  = "deployed_revision"
    regex         = "^([0-9a-f]{40})$"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal_com_nutsnews_image_digest"]
    target_label  = "deployed_image_digest"
    regex         = "^(sha256:[0-9a-f]{64})$"
    replacement   = "$1"
  }
}

{% for source in backend_logs_worker_uplift_container_sources %}
loki.source.journal "container_{{ source.tag | regex_replace('[^A-Za-z0-9_]', '_') }}" {
  max_age       = "{{ backend_logs_journal_max_age }}"
  matches       = "CONTAINER_TAG={{ source.tag }}"
  relabel_rules = loki.relabel.worker_uplift_container_context.rules
  labels        = {
    deployment_environment = "{{ backend_metrics_environment_label }}",
    host                   = "{{ backend_metrics_instance_label }}",
    source                 = "container",
    service                = "{{ source.service }}",
    service_version        = "{{ source.service_version | default('unknown') }}",
    severity               = "info",
  }
  forward_to = [loki.process.backend_logs.receiver]
}

{% endfor %}
loki.process "backend_logs" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  // Reject whole private-key and oversized records before parsing can place
  // any of their fields in Alloy's extracted map.
  stage.drop {
    expression          = "(?i)(BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) KEY|PRIVATE KEY-----)"
    drop_counter_reason = "private_key_marker"
  }

  stage.drop {
    longer_than         = "{{ backend_logs_line_drop_max_size }}"
    drop_counter_reason = "oversized_log_line"
  }

  stage.json {
    expressions = {
      raw_severity        = "level || severity",
      raw_request_id      = "requestId || request_id || attributes.requestId || attributes.request_id",
      raw_correlation_id  = "correlationId || correlation_id",
      raw_causation_id    = "causationId || causation_id",
      raw_message_id      = "messageId || message_id",
      raw_idempotency_key = "idempotencyKey || idempotency_key",
      raw_article_id      = "articleId || article_id || attributes.articleId || attributes.article_id || attributes.canonicalArticleId || attributes.articleIdentityHash",
      raw_feed_id         = "feedId || feed_id || attributes.feedId || attributes.feed_id",
      raw_pipeline_run_id = "pipelineRunId || pipeline_run_id",
      raw_traceparent     = "traceparent",
      raw_queue           = "queue",
      raw_outcome         = "outcome",
    }
    drop_malformed = false
  }

  stage.labels {
    values = {
      raw_severity = "raw_severity",
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(trace|debug)$\"}"

    stage.static_labels {
      values = { severity = "debug" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(info|notice)$\"}"

    stage.static_labels {
      values = { severity = "info" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(warn|warning)$\"}"

    stage.static_labels {
      values = { severity = "warning" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(err|error)$\"}"

    stage.static_labels {
      values = { severity = "error" }
    }
  }

  stage.match {
    selector = "{raw_severity=~\"(?i)^(fatal|panic|critical|crit|alert|emerg|emergency)$\"}"

    stage.static_labels {
      values = { severity = "critical" }
    }
  }

  stage.match {
    selector            = "{severity=\"debug\"}"
    action              = "drop"
    drop_counter_reason = "debug_trace_log_level"
  }

  stage.replace {
    expression = "(?i)[\\\"']?authorization[\\\"']?[[:space:]]*[:=][[:space:]]*[\\\"']?(bearer|basic)[[:space:]]+([^[:space:]\\\"']+)[\\\"']?"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)[\\\"']?(cookie|set-cookie)[\\\"']?[[:space:]]*[:=][[:space:]]*([\\\"'][^\\n\\r\\\"']*[\\\"']|[^\\n\\r]+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)[\\\"']?(api[_-]?key|access[_-]?token|refresh[_-]?token|oauth[_-]?(code|token)|password|passwd|pwd|secret|session|token|tracestate)[\\\"']?[[:space:]]*[:=][[:space:]]*([\\\"'][^\\n\\r\\\"']*[\\\"']|[^[:space:],&\\\"']+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "([?][^[:space:]\\\"']+)"
    replace    = "?[REDACTED_QUERY]"
  }

  stage.replace {
    expression = "([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})"
    replace    = "[REDACTED_EMAIL]"
  }

  stage.truncate {
    rule {
      limit  = "{{ backend_logs_line_truncate_limit }}"
      suffix = "...[TRUNCATED]"
    }
  }

  // Raw JSON fields stay only in Alloy's extracted map. Full-match RE2
  // captures create distinct safe keys, so malformed, opaque, or oversized
  // candidates have no structured-metadata fallback. Opaque W3C tracestate is
  // redacted from the line and intentionally omitted from metadata.
  stage.regex {
    source     = "raw_request_id"
    expression = "^(?P<safe_request_id>[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|feed-[0-9a-f]{32}|enrichment_[0-9a-f]{32}|enrichment-req-[0-9]{3})$"
  }

  stage.regex {
    source     = "raw_correlation_id"
    expression = "^(?P<safe_correlation_id>[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
  }

  stage.regex {
    source     = "raw_causation_id"
    expression = "^(?P<safe_causation_id>[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
  }

  stage.regex {
    source     = "raw_message_id"
    expression = "^(?P<safe_message_id>[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
  }

  // The first idempotency gate enforces the producer's 256-byte ASCII
  // contract. The second gate restricts export to namespaces emitted by the
  // reviewed backend and worker producers; arbitrary token-shaped strings are
  // not promoted merely because they satisfy the broad envelope grammar.
  stage.regex {
    source     = "raw_idempotency_key"
    expression = "^(?P<candidate_idempotency_key>[a-z0-9][a-z0-9._:/-]{0,255})$"
  }

  stage.regex {
    source     = "candidate_idempotency_key"
    expression = "^(?P<safe_idempotency_key>(?P<safe_idempotency_namespace>scheduler:feed|fetcher:canonicalization|canonicalizer:enrichment|enrichment:approval|approval:translation|approval:decision|translation:backlog|translation:result|translation:persistence|persistence:final-shadow|persistence:publication|feed-health|feed|probe:worker-api-final-shadow|smoke:pipeline:feed|smoke:approval:accepted|smoke:approval:rejected|smoke:translation):[a-z0-9][a-z0-9._:/-]*)$"
  }

  stage.regex {
    source     = "raw_article_id"
    expression = "^(?P<safe_article_id>article_[0-9a-f]{32}|article-[a-z0-9][a-z0-9.-]{0,63})$"
  }

  stage.regex {
    source     = "raw_feed_id"
    expression = "^(?P<safe_feed_id>feed-[a-z0-9][a-z0-9.-]{0,63}|worker-shadow-smoke-[a-z0-9][a-z0-9.-]{0,63})$"
  }

  stage.regex {
    source     = "raw_pipeline_run_id"
    expression = "^(?P<safe_pipeline_run_id>[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
  }

  // Validate trace context as one unit and derive trace_id only from the
  // validated traceparent. The second gate intersects the exact-length first
  // gate with non-zero trace/span requirements without RE2 lookarounds.
  stage.regex {
    source     = "raw_traceparent"
    expression = "^(?P<candidate_traceparent>00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2})$"
  }

  stage.regex {
    source     = "candidate_traceparent"
    expression = "^(?P<safe_traceparent>00-(?P<safe_trace_id>[0-9a-f]*[1-9a-f][0-9a-f]*)-(?P<safe_span_id>[0-9a-f]*[1-9a-f][0-9a-f]*)-[0-9a-f]{2})$"
  }

  stage.regex {
    source     = "raw_queue"
    expression = "^(?P<safe_queue>nutsnews[.]worker[.](?P<safe_queue_stage>fetch|canonicalization|enrichment|approval|translation|persistence|publication)[.]v1(?P<safe_queue_suffix>[.](?P<safe_queue_delivery>retry-(?P<safe_queue_retry>30s|5m|30m)|dlq))?)$"
  }

  stage.regex {
    source     = "raw_outcome"
    expression = "^(?P<safe_outcome>started|success|duplicate|invalid|retry|dlq|failure|ok|degraded|unhealthy|inactive|active|cancelled|channel-dropped|recovering|closed|draining|drained)$"
  }

  // Defense in depth: the validators above already impose tighter shape and
  // length constraints. These extracted-field bounds keep future contract
  // extensions from silently increasing per-entry structured metadata.
  stage.truncate {
    rule {
      source_type = "extracted"
      sources     = ["safe_request_id", "safe_correlation_id", "safe_causation_id", "safe_message_id", "safe_trace_id", "safe_pipeline_run_id", "safe_traceparent", "safe_queue"]
      limit       = "64B"
    }

    rule {
      source_type = "extracted"
      sources     = ["safe_article_id", "safe_feed_id"]
      limit       = "96B"
    }

    rule {
      source_type = "extracted"
      sources     = ["safe_idempotency_key"]
      limit       = "256B"
    }

    rule {
      source_type = "extracted"
      sources     = ["safe_outcome"]
      limit       = "24B"
    }
  }

  stage.structured_metadata {
    values = {
      request_id      = "safe_request_id",
      correlation_id  = "safe_correlation_id",
      causation_id    = "safe_causation_id",
      message_id      = "safe_message_id",
      idempotency_key = "safe_idempotency_key",
      trace_id        = "safe_trace_id",
      article_id      = "safe_article_id",
      feed_id         = "safe_feed_id",
      pipeline_run_id = "safe_pipeline_run_id",
      traceparent     = "safe_traceparent",
      queue           = "safe_queue",
      outcome         = "safe_outcome",
      revision        = "deployed_revision",
      image_digest    = "deployed_image_digest",
    }
  }

  stage.label_keep {
    values = ["deployment_environment", "service", "service_version", "host", "source", "severity"]
  }
}
{% endif %}
