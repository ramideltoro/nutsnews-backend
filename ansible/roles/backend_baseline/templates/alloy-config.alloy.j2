}

prometheus.relabel "worker_uplift" {
  forward_to     = [prometheus.remote_write.grafana_cloud.receiver]
  max_cache_size = {{ backend_metrics_worker_uplift_relabel_cache_size }}

  rule {
    source_labels = ["__name__"]
    regex         = "^(up|scrape_.+|nutsnews_.+)$"
    action        = "keep"
  }

  rule {
    target_label = "job"
    replacement  = "nutsnews-worker-uplift"
  }

  rule {
    target_label = "instance"
    replacement  = "{{ backend_metrics_instance_label }}"
  }

  rule {
    target_label = "host"
    replacement  = "{{ backend_metrics_instance_label }}"
  }

  rule {
    target_label = "environment"
    replacement  = "{{ backend_metrics_environment_label }}"
  }

  rule {
    target_label = "deployment_environment"
    replacement  = "{{ backend_metrics_environment_label }}"
  }

  rule {
    target_label = "service_namespace"
    replacement  = "nutsnews"
  }

  rule {
    regex  = "^(article|article_id|feed|feed_id|message|message_id|idempotency|idempotency_key|trace_id|span_id|correlation_id|causation_id|payload|url|path|user|ip|token|secret|prompt|model_output)$"
    action = "labeldrop"
  }

  // result/retry/token_kind remain temporarily for metrics already emitted by
  // the shadow images; all are finite enums and are removed at image rollout.
  rule {
    regex  = "^(__name__|job|instance|environment|deployment_environment|host|service|service_namespace|version|revision|stage|queue|outcome|dependency|language|provider|probe|check|le|expected_active|deployment|deployment_mode|adapter|result|retry|retry_class|token_kind)$"
    action = "labelkeep"
  }
}

