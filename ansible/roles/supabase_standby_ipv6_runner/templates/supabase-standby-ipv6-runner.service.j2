[Unit]
Description=NutsNews Supabase standby one-job IPv6 GitHub Actions runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ supabase_standby_ipv6_runner_user }}
Group={{ supabase_standby_ipv6_runner_group }}
WorkingDirectory={{ supabase_standby_ipv6_runner_install_dir }}
Environment=RUNNER_TOOL_CACHE={{ supabase_standby_ipv6_runner_tool_cache_dir }}
Environment=RUNNER_TEMP={{ supabase_standby_ipv6_runner_work_dir }}/_temp
ExecStart={{ supabase_standby_ipv6_runner_install_dir }}/run.sh
Restart=no
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ supabase_standby_ipv6_runner_install_dir }}
ReadWritePaths={{ supabase_standby_ipv6_runner_work_dir }}
ReadWritePaths={{ supabase_standby_ipv6_runner_tool_cache_dir }}
ReadWritePaths={{ supabase_standby_ipv6_runner_log_dir }}
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
