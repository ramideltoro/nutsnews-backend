{
  "excluded_publication_objects": [
    {
      "object": "public.feed_quality_scores",
      "object_type": "view",
      "reason": "PostgreSQL logical replication publications include base tables, not views; the view is restored/validated through schema and parity checks."
    }
  ],
  "external_references": [
    "https://supabase.com/docs/guides/database/postgres/setup-replication-external",
    "https://supabase.com/docs/guides/database/replication",
    "https://www.postgresql.org/docs/current/sql-altersubscription.html"
  ],
  "issue": 109,
  "extends_for_issue": 213,
  "live_blockers": [
    "#211 protected provisioning must prove nutsnews_primary_shadow before production subscription setup",
    "#212 protected restore must prove the production snapshot in nutsnews_primary_shadow before subscription setup",
    "production-backend protected environment approval is required for live setup"
  ],
  "plan_id": "backend-postgres-logical-replication",
  "publication_tables": [
    "public.ai_usage_runs",
    "public.article_ai_reviews",
    "public.article_summaries",
    "public.articles",
    "public.feed_health",
    "public.migration_schema_contract",
    "public.quota_usage_events",
    "public.release_readiness",
    "public.rss_feeds",
    "public.runtime_feature_flags",
    "public.worker_runs"
  ],
  "refresh_policy": {
    "manifest_change_required": true,
    "when_publication_tables_change": "run ALTER SUBSCRIPTION refresh publication on the backend target after protected approval"
  },
  "replica_identity": {
    "default": "required_primary_key_or_unique_identity",
    "tables_without_identity": [],
    "validation_query": "select n.nspname || '.' || c.relname as table_name from pg_class c join pg_namespace n on n.oid = c.relnamespace where c.relkind = 'r' and n.nspname = 'public' and not exists (select 1 from pg_index i where i.indrelid = c.oid and (i.indisprimary or i.indisreplident))",
    "validation_required": true
  },
  "replication_names": {
    "publication": "nutsnews_backend_migration_pub",
    "slot": "nutsnews_backend_migration_slot",
    "subscription": "nutsnews_backend_migration_sub"
  },
  "rollback": [
    "run protected teardown-dry-run before destructive cleanup",
    "disable or drop backend subscription",
    "drop Supabase replication slot after confirming no subscriber needs it",
    "drop Supabase publication only after production cutover path no longer depends on it",
    "remove migration-only replication credentials after rehearsal or retirement"
  ],
  "safe_metadata_only": true,
  "slot_risk_checks": [
    "pg_replication_slots.active",
    "pg_replication_slots.restart_lsn",
    "retained_wal_bytes_or_lsn_lag",
    "target_subscription_status",
    "backend_disk_free_bytes"
  ],
  "source": {
    "connection_pooler_allowed": false,
    "db_url_secret": "NUTSNEWS_PRODUCTION_SUPABASE_DB_URL",
    "direct_connection_required": true,
    "ipv4_or_ipv6_requirement_must_be_recorded": true,
    "project_ref_secret": "NUTSNEWS_PRODUCTION_SUPABASE_PROJECT_REF"
  },
  "staging_rehearsal": {
    "change_tests": [
      "insert",
      "update",
      "delete",
      "truncate"
    ],
    "production_writes_allowed": false,
    "required_before_production": true,
    "required_status": "streaming_or_equivalent_healthy",
    "source_db_url_secret": "NUTSNEWS_STAGING_SUPABASE_DB_URL",
    "target_database_variable": "NUTSNEWS_BACKEND_POSTGRES_REHEARSAL_DATABASE"
  },
  "production_shadow": {
    "issue": 213,
    "required_after_issues": [
      211,
      212,
      215
    ],
    "source_db_url_secret": "NUTSNEWS_PRODUCTION_SUPABASE_DB_URL",
    "target_database": "nutsnews_primary_shadow",
    "target_database_variable": "NUTSNEWS_BACKEND_POSTGRES_PRIMARY_SHADOW_DATABASE",
    "subscription_copy_data_after_restore": false,
    "workflow_mode": "environment_name=production operation=setup",
    "confirmation": "setup-production-logical-replication",
    "safe_metadata_artifact": "backend-postgres-logical-replication",
    "production_writes_allowed": false
  },
  "post_cutover_teardown": {
    "issue": 114,
    "dry_run_operation": "environment_name=production operation=teardown-dry-run",
    "apply_operation": "environment_name=production operation=teardown confirmation=teardown-production-logical-replication",
    "requires_before_apply": [
      "post-cutover observation-window reconciliation pass",
      "rollback owner coverage through the rollback window",
      "Supabase archive or retirement decision",
      "explicit issue #114 teardown approval"
    ],
    "source_slot_must_be_inactive": true,
    "safe_metadata_artifact": "backend-postgres-logical-replication"
  },
  "status": "post_cutover_teardown_ready_pending_114_approval",
  "target": {
    "database_variable": "NUTSNEWS_BACKEND_POSTGRES_PRIMARY_SHADOW_DATABASE",
