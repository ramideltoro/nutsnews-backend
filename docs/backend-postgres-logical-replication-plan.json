    "production_writes_allowed": false,
    "required_before_production": true,
    "required_status": "streaming_or_equivalent_healthy",
    "source_db_url_secret": "NUTSNEWS_STAGING_SUPABASE_DB_URL",
    "target_database_variable": "NUTSNEWS_BACKEND_POSTGRES_REHEARSAL_DATABASE"
  },
  "production_shadow": {
