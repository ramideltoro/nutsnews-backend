    "parity validation failure",
    "smoke test failure",
    "writer pause cannot be proven",
    "dashboard or health report critical",
    "rollback boundary unclear"
  ],
  "rollback_decision_points": [
    "before backend_postgres_primary accepts writes, return to supabase_primary",
    "after backend-only authoritative writes, use forward recovery unless reviewed sync-back evidence exists"
