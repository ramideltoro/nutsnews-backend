{
  "gate_id": "supabase_standby_schema_compatibility",
  "version": 1,
  "issue": "ramideltoro/nutsnews#524",
  "epic": "ramideltoro/nutsnews#521",
  "goal": "Emit an independent, fail-closed schema compatibility gate for the existing production Supabase standby.",
  "parent_prerequisites": [
    "ramideltoro/nutsnews#497",
    "ramideltoro/nutsnews#499"
  ],
  "input": {
    "authoritative_telemetry": "Backend Health Report supabase_sync_relay_status command output",
    "comparison_source": "relay preflight schema and identity checks plus post_sync sequence metadata presence",
    "contract": "docs/backend-supabase-sync-relay.json",
    "manifest_source": "docs/backend-supabase-sync-relay.json manifest_schema_fingerprint and source_manifest metadata",
    "candidate_manifest": "optional explicit standby_manifest.json for additional local validation",
    "forbidden_inputs": [
      "database URLs",
      "caller-supplied SQL",
      "raw row data",
      "hostnames",
      "Supabase project refs",
      "Supabase keys"
    ]
  },
  "pass_conditions": [
    "candidate application revision is a full 40-character commit SHA",
    "backend sync relay contract carries the #497 manifest schema fingerprint",
    "optional candidate standby manifest fingerprint matches the backend sync relay manifest fingerprint when supplied",
    "optional candidate manifest required table set matches the backend sync relay table set when supplied",
    "optional candidate manifest required sequence set matches the backend sync relay sequence set when supplied",
    "optional candidate manifest keeps the existing production Supabase target and forbids a new project/database when supplied",
    "source and target schema fingerprints match",
    "source and target migration contract fingerprints match",
    "relay schema-fingerprint metadata includes the same manifest schema fingerprint as the backend sync relay contract",
    "every required table has passing manifest replica identity metadata",
    "every required table has passing live source/target primary-key identity metadata",
    "every required sequence has safe metadata proving the named sequence/table/column binding exists",
    "source fingerprint matches the sync relay contract",
    "target fingerprint matches the sync relay contract",
    "health report telemetry is fresh",
    "relay schema telemetry is fresh"
  ],
  "fail_closed_blockers": [
    "invalid_failover_attempt_id",
    "invalid_candidate_application_revision",
    "candidate_application_revision_mismatch",
    "contract_unavailable",
    "contract_malformed",
    "manifest_schema_fingerprint_missing",
    "candidate_manifest_unavailable",
    "candidate_manifest_malformed",
    "candidate_manifest_fingerprint_missing",
    "candidate_manifest_structural_objects_malformed",
    "candidate_manifest_fingerprint_mismatch",
    "candidate_manifest_table_set_mismatch",
    "candidate_manifest_sequence_set_mismatch",
    "candidate_manifest_existing_supabase_not_confirmed",
    "candidate_manifest_new_supabase_project_not_forbidden",
    "candidate_manifest_standby_database_not_forbidden",
    "candidate_manifest_supabase_writes_not_blocked",
    "candidate_manifest_not_safe_metadata",
    "required_function_validation_unavailable",
    "required_view_validation_unavailable",
    "manifest_tables_missing",
    "manifest_tables_malformed",
    "manifest_sequences_malformed",
    "source_policy_mismatch",
    "target_policy_mismatch",
    "target_existing_production_supabase_not_confirmed",
    "new_supabase_project_not_forbidden",
    "nutsnews_standby_database_not_forbidden",
    "backend_primary_policy_mismatch",
    "app_worker_supabase_writes_not_blocked",
    "telemetry_unavailable",
    "telemetry_malformed",
    "relay_telemetry_malformed",
    "relay_telemetry_unavailable",
    "relay_telemetry_not_safe_metadata",
    "telemetry_measurement_time_malformed",
    "telemetry_measurement_time_from_future",
    "telemetry_stale",
    "relay_schema_time_malformed",
    "relay_schema_time_from_future",
    "relay_schema_stale",
    "source_fingerprint_mismatch",
    "target_fingerprint_mismatch",
    "preflight_checks_missing",
    "post_sync_checks_missing",
    "schema_compatibility_failed",
    "identity_compatibility_failed",
    "sequence_binding_failed"
  ],
  "schema_blockers": [
    "schema_check_missing",
    "schema_status_not_pass",
    "schema_metadata_unavailable",
    "schema_fingerprint_missing",
    "schema_fingerprint_mismatch",
    "migration_contract_fingerprint_missing",
    "migration_contract_fingerprint_mismatch",
    "manifest_schema_fingerprint_missing",
    "manifest_schema_fingerprint_mismatch"
  ],
  "identity_blockers": [
    "manifest_identity_check_missing",
    "manifest_identity_status_not_pass",
    "manifest_identity_metadata_unavailable",
    "live_identity_check_missing",
    "live_identity_status_not_pass",
    "live_identity_metadata_unavailable",
    "manifest_replica_identity_not_primary_key",
    "manifest_replica_identity_columns_mismatch",
    "source_primary_key_mismatch",
    "target_primary_key_mismatch"
  ],
  "sequence_binding_blockers": [
    "sequence_binding_check_missing",
    "sequence_metadata_unavailable",
    "sequence_binding_mismatch"
  ],
  "result_schema": {
    "safe_metadata_only": true,
    "status_values": [
      "PASS",
      "FAIL"
    ],
    "required_fields": [
      "status",
      "gate",
      "failover_attempt_id",
      "candidate_application_revision",
      "repository_revision",
      "manifest_fingerprint",
      "candidate_manifest",
      "relay_contract_fingerprint",
      "source_fingerprint",
      "target_fingerprint",
      "measured_at_utc",
      "expires_at_utc",
      "relay_checked_at_utc",
      "relay_schema_age_seconds",
      "schema",
      "required_sequence_count",
      "identity_checks",
      "sequence_bindings",
      "blockers",
      "safe_metadata_only"
    ],
    "identity_fields": [
      "name",
      "status",
      "expected_primary_key_fingerprint",
      "source_primary_key_fingerprint",
      "target_primary_key_fingerprint",
      "source_relation_kind",
      "target_relation_kind",
      "replica_identity_type",
      "blockers"
    ],
    "sequence_binding_fields": [
      "name",
      "status",
      "binding_fingerprint",
      "position_safety_status",
      "blockers"
    ]
  },
  "thresholds": {
    "max_telemetry_age_seconds": 300,
    "result_ttl_seconds": 300
  },
  "workflow": {
    "path": ".github/workflows/backend-supabase-standby-schema-gate.yml",
    "environment": "production-backend",
    "runs_on": "ubuntu-latest",
    "artifact": "backend-supabase-standby-schema-gate",
    "default_enforce": false,
    "candidate_manifest_checkout": "not required; the protected backend workflow uses the backend relay contract as the manifest source"
  },
  "validation": {
    "validator": "python3 scripts/validate_backend_supabase_standby_schema_gate.py",
    "unit_tests": "python3 -m unittest tests.test_backend_supabase_standby_schema_gate",
    "workflow_lint": "actionlint .github/workflows/backend-supabase-standby-schema-gate.yml"
  },
  "scope": "Schema compatibility only. Row parity, sequence position safety, writer pause, split-brain fencing, and the combined decision are separate gates."
}
