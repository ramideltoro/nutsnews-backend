{
  "gate_id": "supabase_standby_sequence_safety",
  "version": 1,
  "issue": "ramideltoro/nutsnews#525",
  "epic": "ramideltoro/nutsnews#521",
  "goal": "Emit an independent, fail-closed sequence safety gate for the existing production Supabase standby.",
  "parent_prerequisites": [
    "ramideltoro/nutsnews#497",
    "ramideltoro/nutsnews#499"
  ],
  "input": {
    "authoritative_telemetry": "Backend Health Report supabase_sync_relay_status command output",
    "comparison_source": "relay post_sync sequence metadata",
    "contract": "docs/backend-supabase-sync-relay.json",
    "forbidden_inputs": [
      "database URLs",
      "caller-supplied SQL",
      "raw row data",
      "hostnames",
      "Supabase project refs",
      "Supabase keys"
    ]
  },
  "pass_conditions": [
    "every manifest sequence has a matching relay sequence check",
    "each relay sequence check is safe sequence_metadata_only metadata",
    "source and target sequence/table/column bindings match the relay contract",
    "source and target sequence increments are exactly 1",
    "source and target sequence cycle is disabled",
    "source and target sequences are owned by exactly one expected table column",
    "source and target sequence next values are inside sequence min/max bounds",
    "source next value is greater than the source owning column max id",
    "target next value is greater than the target owning column max id",
    "target next value is greater than the source owning column max id",
    "target next value is not behind the source next safe value",
    "source fingerprint matches the sync relay contract",
    "target fingerprint matches the sync relay contract",
    "health report telemetry is fresh",
    "relay sequence telemetry is fresh"
  ],
  "fail_closed_blockers": [
    "invalid_failover_attempt_id",
    "contract_unavailable",
    "contract_malformed",
    "manifest_sequences_missing",
    "manifest_sequences_malformed",
    "source_policy_mismatch",
    "target_policy_mismatch",
    "target_existing_production_supabase_not_confirmed",
    "new_supabase_project_not_forbidden",
    "nutsnews_standby_database_not_forbidden",
    "backend_primary_policy_mismatch",
    "app_worker_supabase_writes_not_blocked",
    "telemetry_unavailable",
    "telemetry_malformed",
    "relay_telemetry_malformed",
    "relay_telemetry_unavailable",
    "relay_telemetry_not_safe_metadata",
    "telemetry_measurement_time_malformed",
    "telemetry_measurement_time_from_future",
    "telemetry_stale",
    "relay_sequence_time_malformed",
    "relay_sequence_time_from_future",
    "relay_sequence_stale",
    "source_fingerprint_mismatch",
    "target_fingerprint_mismatch",
    "post_sync_checks_missing",
    "sequence_safety_failed"
  ],
  "sequence_blockers": [
    "sequence_check_missing",
    "sequence_status_not_pass",
    "sequence_metadata_sensitivity_mismatch",
    "sequence_contract_mismatch",
    "sequence_metadata_unavailable",
    "source_next_value_missing",
    "target_next_value_missing",
    "source_sequence_min_value_missing",
    "target_sequence_min_value_missing",
    "source_sequence_max_value_missing",
    "target_sequence_max_value_missing",
    "source_is_called_missing",
    "target_is_called_missing",
    "source_increment_by_missing",
    "target_increment_by_missing",
    "source_sequence_increment_missing",
    "target_sequence_increment_missing",
    "source_sequence_increment_not_one",
    "target_sequence_increment_not_one",
    "sequence_increment_mismatch",
    "source_sequence_cycle_missing",
    "target_sequence_cycle_missing",
    "source_sequence_cycle_enabled",
    "target_sequence_cycle_enabled",
    "source_owned_by_count_missing",
    "target_owned_by_count_missing",
    "source_sequence_ownership_missing",
    "target_sequence_ownership_missing",
    "source_expected_binding_matches_missing",
    "target_expected_binding_matches_missing",
    "source_sequence_unowned",
    "target_sequence_unowned",
    "source_sequence_multiple_owners",
    "target_sequence_multiple_owners",
    "source_sequence_misbound",
    "target_sequence_misbound",
    "source_sequence_range_metadata_missing",
    "target_sequence_range_metadata_missing",
    "source_sequence_exhausted",
    "target_sequence_exhausted",
    "source_next_value_not_above_source_max_id",
    "target_next_value_not_above_target_max_id",
    "target_next_value_not_above_source_max_id",
    "target_next_value_lt_source_next_value"
  ],
  "result_schema": {
    "safe_metadata_only": true,
    "status_values": [
      "PASS",
      "FAIL"
    ],
    "required_fields": [
      "status",
      "gate",
      "failover_attempt_id",
      "repository_revision",
      "manifest_fingerprint",
      "relay_contract_fingerprint",
      "source_fingerprint",
      "target_fingerprint",
      "measured_at_utc",
      "expires_at_utc",
      "relay_checked_at_utc",
      "relay_sequence_age_seconds",
      "required_sequence_count",
      "passed_sequence_count",
      "failed_sequence_count",
      "sequences",
      "blockers",
      "safe_metadata_only"
    ],
    "per_sequence_fields": [
      "name",
      "table",
      "column",
      "status",
      "source_last_value",
      "source_next_value",
      "source_is_called",
      "source_increment_by",
      "source_sequence_min_value",
      "source_sequence_max_value",
      "source_sequence_cycle",
      "source_max_id",
      "target_last_value",
      "target_next_value",
      "target_is_called",
      "target_increment_by",
      "target_sequence_min_value",
      "target_sequence_max_value",
      "target_sequence_cycle",
      "target_max_id",
      "binding_fingerprint",
      "blockers",
      "safe_metadata_only"
    ]
  },
  "thresholds": {
    "max_telemetry_age_seconds": 300,
    "result_ttl_seconds": 300
  },
  "workflow": {
    "path": ".github/workflows/backend-supabase-standby-sequence-gate.yml",
    "environment": "production-backend",
    "runs_on": "ubuntu-latest",
    "artifact": "backend-supabase-standby-sequence-gate",
    "default_enforce": false
  },
  "validation": {
    "local_validator": "python3 scripts/validate_backend_supabase_standby_sequence_gate.py",
    "unit_tests": "python3 -m unittest tests.test_backend_supabase_standby_sequence_gate",
    "workflow_lint": "actionlint .github/workflows/backend-supabase-standby-sequence-gate.yml"
  },
  "scope": "Sequence position and configuration safety only. Row parity, schema compatibility, writer pause, split-brain fencing, and the combined decision are separate gates."
}
