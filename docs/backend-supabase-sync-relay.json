  "source": {
    "label": "backend_postgres_primary",
    "role": "normal production read/write primary",
    "db_url_env": "NUTSNEWS_BACKEND_PRIMARY_DB_URL",
    "database_variable": "NUTSNEWS_BACKEND_POSTGRES_PRIMARY_DATABASE",
    "network_path": "backend_host_loopback_postgresql",
    "public_5432_allowed": false
  },
  "target": {
    "label": "existing_production_supabase_standby",
    "role": "backup/hot standby target",
    "db_url_env": "NUTSNEWS_PRODUCTION_SUPABASE_DB_URL",
    "existing_production_supabase_project": true,
    "create_new_supabase_project": false,
    "create_nutsnews_standby_database": false,
    "network_path": "backend_host_outbound_to_supabase_postgresql"
  },
  "relay": {
    "direction": "backend-postgres-to-existing-production-supabase",
    "runtime": "backend-host-systemd-timer",
    "service": "nutsnews-supabase-sync-relay.service",
    "timer": "nutsnews-supabase-sync-relay.timer",
    "interval_seconds": 30,
    "mode": "snapshot-apply-relay",
    "supported_change_types": [
      "insert",
      "update",
      "delete",
      "sequence-readiness"
    ],
    "apply_strategy": "copy-source-snapshot-to-temp-table-update-insert-delete-target-rows",
    "sequence_readiness_metadata_fields": [
      "last_value",
      "next_value",
      "is_called",
      "increment_by",
      "min_value",
      "max_value",
      "cycle",
      "owned_by_table",
      "owned_by_column",
      "owned_by_count",
      "expected_binding_matches",
      "owning_column_max_id"
    ],
    "fail_closed_before_target_mutation": [
      "schema-fingerprint-mismatch",
      "migration-contract-fingerprint-mismatch",
      "manifest-table-identity-missing",
      "source-table-identity-mismatch",
      "target-table-identity-mismatch",
      "unsafe-replica-identity"
    ],
    "app_worker_supabase_write_credentials_injected": false,
    "supabase_as_production_provider_before_failover": false
  },
  "health": {
    "issue": "ramideltoro/nutsnews#500",
    "report_path": "/var/lib/nutsnews/supabase-sync-relay/last-run.json",
    "check_name": "supabase_sync_relay_health",
    "lag_critical_seconds": 30,
    "source": "backend_health_report",
    "safe_metadata_only": true,
    "reported_fields": [
      "timer_state",
      "service_state",
      "service_result",
      "last_applied_at_utc",
      "lag_seconds",
      "failed_table_count",
      "last_error"
    ],
    "critical_blockers": [
      "relay_timer_stopped",
      "relay_timer_not_enabled",
      "relay_service_last_result_failed",
      "relay_report_missing",
      "relay_report_invalid",
      "relay_last_run_not_pass",
      "relay_report_not_marked_safe_metadata_only",
      "relay_lag_unknown",
      "relay_lag_exceeds_threshold",
      "relay_failed_table_count_unknown",
      "relay_failed_tables_present"
    ],
    "failover_decision": {
      "lag_over_threshold": "blocked",
      "missing_or_failed_relay": "blocked",
      "scope": "health telemetry only; final failover remains gated by #521"
    }
  },
  "safety": {
    "safe_metadata_only_report": true,
    "backend_postgresql_remains_primary": true,
    "target_is_existing_production_supabase": true,
    "app_worker_writes_to_supabase_before_failover": false,
    "no_inbound_supabase_connection_to_backend_postgres": true,
    "service_env_file_owner": "root:nutsnews-standby-relay",
    "service_env_file_mode": "0640",
    "safe_report_file_mode": "0644",
    "safe_report_state_dir_mode": "0755",
    "service_user": "nutsnews-standby-relay",
    "failover_requires_later_gates": [
      "lag-seconds-lte-30",
      "table-parity-match",
      "schema-fingerprint-match",
      "sequence-safety-verified",
      "primary-writers-paused",
      "split-brain-absence-verified"
    ],
    "forbidden_evidence": [
      "database URLs",
      "passwords",
      "tokens",
      "service-role keys",
      "raw row data",
      "PostgreSQL error text"
    ]
  },
