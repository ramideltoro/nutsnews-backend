  "required_behavior": [
    {
      "id": "roles-grants-rls",
      "owner": "backend_operations",
      "description": "Roles, grants, default privileges, RLS policies, functions, triggers, indexes, constraints, publications, and extension versions must match this manifest or be waived before cutover.",
      "validation_method": "catalog_diff_safe_metadata"
    },
    {
      "id": "migration-history",
      "owner": "release_operations",
      "description": "Supabase migration history and repository migration files must match before dump, restore, replication, staging rehearsal, or production cutover continues.",
      "validation_method": "scripts/check_supabase_migration_drift.py --enforce"
    },
    {
      "id": "single-writer",
      "owner": "backend_operations",
      "description": "Supabase remains the only production writer until #119 is explicitly approved and executed. No phase may permit concurrent writes to Supabase and backend PostgreSQL.",
      "validation_method": "cutover_checklist_gate"
    }
  ],
  "excluded_objects": [
    {
      "id": "schema.auth",
      "object_type": "schema",
      "name": "auth",
      "classification": "keep_on_supabase_temporarily",
      "owner": "app_api",
      "reason": "Current backend inventory says admin authentication is handled by NextAuth Google/JWT; bare PostgreSQL restore only needs an auth.users shim when public foreign keys require it.",
      "cutover_risk": "medium; app auth assumptions must be verified in #106/#111 before production cutover"
    },
    {
      "id": "schema.storage",
      "object_type": "schema",
      "name": "storage",
      "classification": "keep_on_supabase_temporarily",
      "owner": "app_api",
      "reason": "Supabase backups cover storage metadata, not restored object bytes; no repo-owned storage client dependency is confirmed.",
      "cutover_risk": "high if app object storage usage exists; #106 must decide byte migration or removal"
    },
    {
      "id": "schema.realtime",
      "object_type": "schema",
      "name": "realtime",
      "classification": "exclude_with_reason",
      "owner": "app_api",
      "reason": "No Supabase Realtime client dependency is identified in this backend repo; logical replication is tracked separately.",
      "cutover_risk": "medium until #106 verifies app/runtime usage"
    },
    {
      "id": "platform.edge-functions",
      "object_type": "platform_feature",
      "name": "edge_functions",
      "classification": "exclude_with_reason",
      "owner": "app_api",
      "reason": "No Edge Function dependency is identified in this backend repo.",
      "cutover_risk": "medium until #106 verifies Supabase project and app usage"
    },
    {
      "id": "platform.postgrest-data-api",
      "object_type": "platform_feature",
      "name": "postgrest_data_api",
      "classification": "replace",
      "owner": "app_api",
      "reason": "Bare PostgreSQL is not compatible with supabase-js/PostgREST clients.",
      "cutover_risk": "critical; #111 blocks production cutover"
    }
  ],
  "validation_strategy": {
    "row_counts": {
      "required_for_object_types": [
        "table",
        "materialized_view",
        "view"
      ],
      "emit": "counts only"
    },
    "checksums": {
      "required_for_high_value_tables": true,
      "emit": "hash digests only; no row data"
    },
    "sequences": {
      "required": true,
      "emit": "sequence name, last_value, max_referenced_id, pass/fail"
    },
    "schema_behavior": {
      "required": true,
      "emit": "object names, definitions hashes, grants, RLS policy names, extension versions"
    }
  },
  "workflow_contract": {
    "dump": {
      "issue": 103,
      "must_include": [
        "roles",
        "schema",
        "data",
        "supabase_migrations when available",
        "safe metadata manifest"
      ],
      "must_exclude": [
        "secret values",
        "database dumps in git",
        "row-level data in logs"
      ]
    },
    "restore": {
      "issue": 104,
      "default_target": "nutsnews_restore_rehearsal",
      "production_target_allowed_by_default": false
    },
    "validation": {
      "issue": 107,
      "report_states": [
        "pass",
        "fail",
        "skipped_with_reason",
        "warning"
      ],
      "failed_required_check_blocks_cutover": true
    },
    "cutover": {
      "issue": 119,
      "requires_explicit_approval": true,
      "supabase_remains_writer_until_approved": true
    }
  },
  "manifest_change_policy": {
    "required_when_schema_changes": true,
    "owner": "release_operations",
    "enforced_by": "runbooks/DB_MIGRATION_CHANGE_FREEZE.md"
  },
