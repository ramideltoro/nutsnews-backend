  "probe_program_contract": {
    "source_path": "scripts/nutsnews_standby_supabase_probe.py",
    "path": "/usr/local/libexec/nutsnews-standby-supabase-probe",
    "owner": "root",
    "mode": "0755",
    "writable_by_probe_user": false,
    "input": {
      "source": "stdin only",
      "shape": "exactly one bounded PostgreSQL URL",
      "rejects": [
        "empty input",
        "multiline input",
        "oversized input",
        "non-PostgreSQL protocol",
        "unexpected Supabase project ref",
        "unexpected host",
        "unexpected port",
        "unexpected database",
        "missing credentials",
        "missing sslmode=require",
        "non-empty SSH_ORIGINAL_COMMAND"
      ]
    },
    "validated_target": {
      "protocols": ["postgres", "postgresql"],
      "host_pattern": "db.<expected-project-ref>.supabase.co",
      "port": 5432,
      "database": "postgres",
      "tls": "sslmode=require",
      "expected_project_source": "protected backend environment input"
    },
    "execution": {
      "sql": "one fixed read-only query owned by the backend program",
      "caller_supplied_sql": false,
      "caller_supplied_executable": false,
      "caller_supplied_arguments": false,
      "psql_uri_in_argv": false,
      "connection_timeout": true,
      "statement_timeout": true,
      "hard_timeout": true,
      "flock_serialization": true,
      "raw_stdout_stderr_discarded": true
    },
    "output": {
      "success": "READY",
      "failure": "generic failure only",
      "forbidden": [
        "credentials",
        "database URL",
        "database user",
        "database password",
        "Supabase project ref",
        "Supabase hostname",
        "PostgreSQL error text",
        "row data"
      ]
    },
    "persistence": {
      "database_url_on_backend": false,
      "probe_logs_sensitive_values": false
    }
  },
