    "writes_allowed": false,
    "production_cutover_authorized": false,
    "live_legacy_owner": "legacy_shards"
  },
  "approved_budgets": {
    "max_stage_pending_outbox_age_seconds": 900,
    "max_failed_shadow_api_requests": 0,
    "max_worker_uplift_active_owner_rows": 0,
    "max_openai_shadow_records": 0,
    "max_dlq_growth_per_smoke": 0,
    "max_missing_consumers": 0,
    "max_root_disk_used_percent": 80,
    "max_memory_used_percent": 80,
    "max_load_per_vcpu": 1.5,
    "max_failed_systemd_units": 0,
    "max_queue_messages_ready": 100,
    "max_queue_messages_unacknowledged": 10
