      "replicas": 1,
      "runtime_mode": "shadow"
    },
    "fetcher": {
      "replicas": 1,
      "concurrency": 2,
      "prefetch": 4,
      "connect_timeout_ms": 5000,
      "read_timeout_ms": 10000,
      "total_timeout_ms": 15000
    },
    "canonicalizer": {
      "replicas": 1,
      "concurrency": 2,
      "prefetch": 4
    },
    "enrichment": {
      "replicas": 1,
      "concurrency": 2,
      "prefetch": 4,
      "connect_timeout_ms": 5000,
      "read_timeout_ms": 10000,
      "total_timeout_ms": 30000,
      "max_response_bytes": 1048576
    },
    "approval": {
      "replicas": 1,
      "concurrency": 1,
      "prefetch": 2,
      "qwen_max_parallel_calls": 1,
      "qwen_max_queued_calls": 1,
      "openai_fallback_enabled": false,
      "openai_fallback_budget_usd": 0
    },
    "translation": {
      "replicas": 1,
      "concurrency": 1,
      "per_language_concurrency": 1,
      "prefetch": 2,
      "quality_min_score": 80,
      "quality_reprompt_max_attempts": 2
    },
    "persistence": {
      "replicas": 1,
      "concurrency": 1,
      "prefetch": 2
    },
    "publication": {
      "replicas": 1,
      "concurrency": 1,
      "prefetch": 2,
      "production_visibility_enabled": false
    }
  },
  "required_sections": [
    {
      "id": "observation_window",
