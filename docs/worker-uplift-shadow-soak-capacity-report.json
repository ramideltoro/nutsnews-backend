      "sensitivity": "aggregate_only"
    },
    {
      "id": "runtime_guardrails",
      "category": "shadow_safety",
      "sensitivity": "safe_runtime_metadata_only"
    },
    {
      "id": "queue_and_dlq_headroom",
      "category": "rabbitmq_capacity",
      "sensitivity": "aggregate_only"
    },
    {
      "id": "stage_error_and_retry_pressure",
      "category": "worker_capacity",
      "sensitivity": "aggregate_only"
    },
    {
      "id": "ai_cost_and_qwen_saturation",
      "category": "model_capacity_cost",
      "sensitivity": "aggregate_only"
    },
    {
      "id": "host_and_telemetry_headroom",
      "category": "single_host_capacity",
