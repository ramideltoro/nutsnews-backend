  "exit_triggers": [
    "Any sustained worker-uplift main queue growth beyond the approved queue ready/unacknowledged budgets.",
    "Any unexplained pending outbox age above 900 seconds after reconciliation/drain.",
    "Any worker-uplift row marking active_ingestion_owner=worker_uplift before cutover approval.",
    "Any shadow OpenAI usage while local Qwen is the approved AI provider.",
    "Host memory, disk, or load exceeding approved headroom budgets during representative soak.",
    "Any production publication or visibility path enabled outside the protected cutover workflow.",
    "Any evidence that single-node RabbitMQ cannot catch up inside the recovery RTO with safe host headroom."
  ],
  "guardrails": [
    "Report queries must be SELECT-only and aggregate/key-status oriented.",
    "Report artifacts must not include article body, prompt text, model output, credentials, database URLs, or bearer tokens.",
    "Legacy shards remain the production ingestion owner during the soak.",
    "The report can record insufficient_window, but that status cannot close the soak issue.",
    "The report cannot authorize cutover or production publication visibility."
  ]
